// autowisp.cpp
// UI-backed Auto Wisp module for PCM_MAIN.
// This file is meant to be INCLUDED by main.cpp, like the other PCM modules.
// It has no int main(), no OpenCV dependency, and no standalone window.
// It reads the existing Auto Wisp UI/settings from HKCU\Software\PCM_MENU:
//   ModCard_4_Enabled
//   WispSequenceCount
//   WispSequence_N_ScanCode
//   WispSequence_N_Sequence
//
// Behavior:
//   When Auto Wisp is enabled in the UI and Roblox is the foreground process,
//   pressing a configured trigger key sends that row''s configured character sequence.

#ifndef PCM_AUTOWISP_UI_MODULE_INCLUDED
#define PCM_AUTOWISP_UI_MODULE_INCLUDED

#define NOMINMAX
#include <windows.h>
#include <tlhelp32.h>
#include <atomic>
#include <chrono>
#include <cwctype>
#include <mutex>
#include <string>
#include <thread>
#include <vector>

namespace AutoWisp {

struct Sequence {
    USHORT triggerScanCode = 0;
    std::wstring chars;
};

static std::atomic<bool> g_running{false};
static std::atomic<bool> g_enabled{false};
static std::atomic<bool> g_sending{false};
static std::thread g_worker;
static std::mutex g_sequencesMutex;
static std::vector<Sequence> g_sequences;
static bool g_previousDown[256] = {};

static constexpr DWORD kConfigRefreshMs = 250;
static constexpr DWORD kPollSleepMs = 8;
static constexpr DWORD kKeyDelayMs = 35;

static bool ReadDwordValue(HKEY key, const wchar_t* name, DWORD& out) {
    DWORD type = 0;
    DWORD size = sizeof(DWORD);
    DWORD value = 0;
    if (RegQueryValueExW(key, name, nullptr, &type, reinterpret_cast<LPBYTE>(&value), &size) == ERROR_SUCCESS &&
        type == REG_DWORD) {
        out = value;
        return true;
    }
    return false;
}

static bool ReadStringValue(HKEY key, const std::wstring& name, std::wstring& out) {
    DWORD type = 0;
    DWORD size = 0;
    if (RegQueryValueExW(key, name.c_str(), nullptr, &type, nullptr, &size) != ERROR_SUCCESS ||
        type != REG_SZ ||
        size < sizeof(wchar_t)) {
        return false;
    }

    std::wstring buffer;
    buffer.resize(size / sizeof(wchar_t));
    if (RegQueryValueExW(key, name.c_str(), nullptr, &type,
                         reinterpret_cast<LPBYTE>(&buffer[0]), &size) != ERROR_SUCCESS) {
        return false;
    }

    if (!buffer.empty() && buffer.back() == L''\0'') {
        buffer.pop_back();
    }

    out = buffer;
    return true;
}

static void RefreshConfigFromUiRegistry() {
    HKEY key = nullptr;
    if (RegOpenKeyExW(HKEY_CURRENT_USER, L"Software\\PCM_MENU", 0, KEY_READ, &key) != ERROR_SUCCESS) {
        g_enabled.store(false);
        std::lock_guard<std::mutex> lock(g_sequencesMutex);
        g_sequences.clear();
        return;
    }

    DWORD enabled = 0;
    ReadDwordValue(key, L"ModCard_4_Enabled", enabled);
    g_enabled.store(enabled != 0);

    DWORD count = 0;
    ReadDwordValue(key, L"WispSequenceCount", count);
    if (count > 100) count = 100;

    std::vector<Sequence> fresh;
    fresh.reserve(count);

    for (DWORD i = 0; i < count; ++i) {
        wchar_t baseName[64];
        swprintf_s(baseName, L"WispSequence_%lu", i);

        std::wstring scanName = std::wstring(baseName) + L"_ScanCode";
        std::wstring sequenceName = std::wstring(baseName) + L"_Sequence";

        DWORD scanCodeValue = 0;
        std::wstring sequenceText;

        if (!ReadDwordValue(key, scanName.c_str(), scanCodeValue)) {
            continue;
        }
        if (!ReadStringValue(key, sequenceName, sequenceText)) {
            continue;
        }

        Sequence s;
        s.triggerScanCode = static_cast<USHORT>(scanCodeValue);
        s.chars = sequenceText;

        if (s.triggerScanCode != 0 && !s.chars.empty()) {
            fresh.push_back(std::move(s));
        }
    }

    RegCloseKey(key);

    {
        std::lock_guard<std::mutex> lock(g_sequencesMutex);
        g_sequences.swap(fresh);
    }
}

static bool ProcessNameForPid(DWORD pid, wchar_t* outName, size_t outCount) {
    if (!outName || outCount == 0) return false;
    outName[0] = L''\0'';

    HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (snapshot == INVALID_HANDLE_VALUE) return false;

    PROCESSENTRY32W entry = {};
    entry.dwSize = sizeof(entry);

    bool found = false;
    if (Process32FirstW(snapshot, &entry)) {
        do {
            if (entry.th32ProcessID == pid) {
                wcsncpy_s(outName, outCount, entry.szExeFile, _TRUNCATE);
                found = true;
                break;
            }
        } while (Process32NextW(snapshot, &entry));
    }

    CloseHandle(snapshot);
    return found;
}

static bool IsRobloxForeground() {
    HWND foreground = GetForegroundWindow();
    if (!foreground) return false;

    DWORD pid = 0;
    GetWindowThreadProcessId(foreground, &pid);
    if (pid == 0) return false;

    wchar_t exeName[MAX_PATH] = {};
    if (!ProcessNameForPid(pid, exeName, MAX_PATH)) return false;

    return _wcsicmp(exeName, L"RobloxPlayerBeta.exe") == 0;
}

static WORD ScanCodeFromVirtualKey(WORD vk) {
    UINT sc = MapVirtualKeyW(vk, MAPVK_VK_TO_VSC);
    return static_cast<WORD>(sc & 0xFF);
}

static WORD VirtualKeyFromScanCode(USHORT scanCode) {
    UINT vk = MapVirtualKeyW(scanCode, MAPVK_VSC_TO_VK_EX);
    if (vk == 0) {
        vk = MapVirtualKeyW(scanCode, MAPVK_VSC_TO_VK);
    }
    return static_cast<WORD>(vk & 0xFF);
}

static void SendScanCode(WORD scanCode, bool keyUp) {
    if (scanCode == 0) return;

    INPUT input = {};
    input.type = INPUT_KEYBOARD;
    input.ki.wScan = scanCode;
    input.ki.dwFlags = KEYEVENTF_SCANCODE | (keyUp ? KEYEVENTF_KEYUP : 0);

    SendInput(1, &input, sizeof(INPUT));
}

static void TapScanCode(WORD scanCode) {
    if (scanCode == 0) return;
    SendScanCode(scanCode, false);
    Sleep(kKeyDelayMs);
    SendScanCode(scanCode, true);
    Sleep(kKeyDelayMs);
}

static void TapVirtualKey(WORD vk) {
    WORD sc = ScanCodeFromVirtualKey(vk);
    TapScanCode(sc);
}

static void TapCharacter(wchar_t ch) {
    if (ch == 0) return;

    wchar_t upper = static_cast<wchar_t>(towupper(ch));

    // Match the old Python behavior: pressing letters as key taps, not Shift+letter.
    if (upper >= L''A'' && upper <= L''Z'') {
        TapVirtualKey(static_cast<WORD>(upper));
        return;
    }

    if (ch >= L''0'' && ch <= L''9'') {
        TapVirtualKey(static_cast<WORD>(ch));
        return;
    }

    SHORT packed = VkKeyScanW(ch);
    if (packed != -1) {
        BYTE vk = LOBYTE(packed);
        BYTE modifiers = HIBYTE(packed);

        if (modifiers & 1) SendScanCode(ScanCodeFromVirtualKey(VK_SHIFT), false);
        if (modifiers & 2) SendScanCode(ScanCodeFromVirtualKey(VK_CONTROL), false);
        if (modifiers & 4) SendScanCode(ScanCodeFromVirtualKey(VK_MENU), false);

        TapVirtualKey(vk);

        if (modifiers & 4) SendScanCode(ScanCodeFromVirtualKey(VK_MENU), true);
        if (modifiers & 2) SendScanCode(ScanCodeFromVirtualKey(VK_CONTROL), true);
        if (modifiers & 1) SendScanCode(ScanCodeFromVirtualKey(VK_SHIFT), true);
        Sleep(kKeyDelayMs);
        return;
    }

    // Fallback for unmappable characters.
    INPUT input[2] = {};
    input[0].type = INPUT_KEYBOARD;
    input[0].ki.wScan = ch;
    input[0].ki.dwFlags = KEYEVENTF_UNICODE;

    input[1].type = INPUT_KEYBOARD;
    input[1].ki.wScan = ch;
    input[1].ki.dwFlags = KEYEVENTF_UNICODE | KEYEVENTF_KEYUP;

    SendInput(2, input, sizeof(INPUT));
    Sleep(kKeyDelayMs);
}

static void SendSequence(const std::wstring& chars) {
    if (chars.empty()) return;

    g_sending.store(true);
    for (wchar_t ch : chars) {
        if (!g_running.load()) break;
        TapCharacter(ch);
    }
    g_sending.store(false);
}

static void WorkerLoop() {
    DWORD lastRefresh = 0;

    while (g_running.load()) {
        DWORD now = GetTickCount();
        if (now - lastRefresh >= kConfigRefreshMs) {
            RefreshConfigFromUiRegistry();
            lastRefresh = now;
        }

        if (!g_enabled.load() || g_sending.load() || !IsRobloxForeground()) {
            Sleep(kPollSleepMs);
            continue;
        }

        std::vector<Sequence> local;
        {
            std::lock_guard<std::mutex> lock(g_sequencesMutex);
            local = g_sequences;
        }

        for (const auto& seq : local) {
            WORD vk = VirtualKeyFromScanCode(seq.triggerScanCode);
            if (vk == 0 || vk >= 256) continue;

            bool down = (GetAsyncKeyState(vk) & 0x8000) != 0;
            if (down && !g_previousDown[vk]) {
                SendSequence(seq.chars);
            }
            g_previousDown[vk] = down;
        }

        Sleep(kPollSleepMs);
    }
}

void Start() {
    if (g_running.exchange(true)) return;
    ZeroMemory(g_previousDown, sizeof(g_previousDown));
    RefreshConfigFromUiRegistry();
    g_worker = std::thread(WorkerLoop);
}

void Stop() {
    if (!g_running.exchange(false)) return;
    if (g_worker.joinable()) {
        g_worker.join();
    }
    g_enabled.store(false);
    g_sending.store(false);
    std::lock_guard<std::mutex> lock(g_sequencesMutex);
    g_sequences.clear();
}

bool IsRunning() {
    return g_running.load();
}

bool IsEnabled() {
    return g_enabled.load();
}

// Keeps Auto Wisp connected to the existing UI without requiring main.cpp
// to call into this module. The module polls the UI registry settings.
struct AutoStartGuard {
    AutoStartGuard() { AutoWisp::Start(); }
    ~AutoStartGuard() { AutoWisp::Stop(); }
};

static AutoStartGuard g_autoStartGuard;

} // namespace AutoWisp

#endif // PCM_AUTOWISP_UI_MODULE_INCLUDED

